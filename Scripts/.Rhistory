dissimilarity_matrix
#Hierarchical Clustering
# Step 1: Compute Bray-Curtis dissimilarity matrix for clustering
dissimilarity_matrix <- vegdist(spdata, method = "bray")
dissimilarity_matrix
# Step 2: Perform hierarchical clustering
hc_result <- hclust(dissimilarity_matrix, method = "ward.D2") # ward.D2 is commonly used for ecological data
hc_result
# Step 3: Plot dendrogram
plot(hc_result, main = "Hierarchical Clustering Dendrogram", xlab = "", sub = "", cex = 0.8)
# Add color to clusters (choose k based on your preference or criteria like silhouette width)
rect.hclust(hc_result, k = 3, border = "red")
